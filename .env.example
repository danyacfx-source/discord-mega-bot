BOT_TOKEN=ваш_токен_бота
BOT_PREFIX=!
DB_PATH=data/bot.db
LOG_LEVEL=INFO
STATUS_ACTIVITY=играет с кодом
# OWNER_ID=112233445566778899

# ── Донаты (DonationAlerts) ──────────────────────────────────────────────────
# Токены получаются авторизацией DonationAlerts (scope oauth-donation-index).
# Без токена модуль донатов выключен.
# DONATIONS_TOKEN=
# DONATIONS_CLIENT_ID=
# DONATIONS_REFRESH_TOKEN=
# DONATION_ROLE_NAME=Спонсор
# DONATION_CODE_PREFIX=VIP
# DONATION_ROLE_ID=
# DONATION_MIN_AMOUNT=150
# DONATE_BUTTON_CHANNEL_ID=
# DONATE_BONUSES=бонус1,бонус2
# DONATION_NOTIFY_CHANNEL_ID=
# DONATE_URL=https://www.donationalerts.com/r/ваш_ник
# DONATION_POLL_SECONDS=15

# ── Twitch ───────────────────────────────────────────────────────────────────
# Client id/secret из apps.twitch.tv. Без них модуль Twitch выключен.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_CHANNELS=channel1,channel2
# TWITCH_NOTIFY_CHANNEL_ID=
# TWITCH_PING_ROLE_ID=
# TWITCH_POLL_SECONDS=300

# ── Kick (стримы и модерация) ────────────────────────────────────────────────
# KICK_CHANNEL_SLUG=ник_канала
# KICK_NOTIFY_CHANNEL_ID=
# KICK_PING_ROLE_ID=
# KICK_POLL_SECONDS=300
# KICK_MOD_CHANNEL_ID=      # числовой ID канала на Kick для модерации
# KICK_ACCESS_TOKEN=        # Dev API токен (scope user:read moderation:ban channel:read)
# KICK_BAN_WORDS=слово1,слово2
# KICK_PUSHER_APP_KEY=32cbd69e4b950bf97679
# KICK_PUSHER_HOST=ws-us2.pusher.com

# ── Расширенные логи ─────────────────────────────────────────────────────────
# LOGS_IGNORE_CHANNEL_IDS=111,222
# LOGS_IGNORE_CATEGORY_IDS=111,222    # исключить целые категории из логов

# ── Правила-гейт ─────────────────────────────────────────────────────────────
# RULES_MESSAGE_ID=
# RULES_ROLE_ID=

# ── Временные голосовые каналы ───────────────────────────────────────────────
# TEMP_VOICE_TRIGGER_IDS=111,222
# TEMP_VOICE_CATEGORY_ID=    # необязательно: по умолчанию канал создаётся в категории триггера

# ── Вебпанель конструктора эмбедов ────────────────────────────────────────────
# PANEL_PORT=17890            # раскомментируйте, чтобы включить панель
# PANEL_HOST=127.0.0.1
# PANEL_PASSWORD=              # если пусто — на страницу встраивается токен из data/.panel-token
# PANEL_PUBLIC_URL=            # внешний адрес для проверки Origin (если фронт не на localhost)

# ── Дни рождения ──────────────────────────────────────────────────────────────
# BIRTHDAY_CHANNEL_ID=        # куда слать ежедневные анонсы (без него модуль выключен)
# BIRTHDAY_ANNOUNCE_HOUR=9    # час анонса (0–23)
# BIRTHDAY_PING_ROLE_ID=      # роль для пинга при анонсе

# ── Оверлей (OBS) ──────────────────────────────────────────────────────────────
# OVERLAY_PORT=8765           # раскомментируйте, чтобы включить оверлей
# OVERLAY_HOST=127.0.0.1
# OVERLAY_TOKEN=              # если пусто — генерится и сохраняется в data/.overlay-token
# OVERLAY_DONATION_GOAL_ENABLED=0
# OVERLAY_DONATION_GOAL_TARGET=500
# OVERLAY_DONATION_GOAL_CURRENCY=₽
# OVERLAY_DONATION_GOAL_LABEL=Донат-цель
# OVERLAY_DONATION_GOAL_CURRENT=0

# ── Отчёт по ОЗУ (RamReport) ───────────────────────────────────────────────────
# RAM_REPORT_CHANNEL_ID=      # куда слать отчёт по памяти бота (без него выключен)
# RAM_REPORT_INTERVAL_MINUTES=30
# RAM_REPORT_TRACEMALLOC=1    # трассировка аллокаций (перфоманс-оверхед; 0 чтобы выключить)

# ── Меню ролей (role_menu, перенесено с Node) ─────────────────────────────────
# ROLE_MENU_ENABLED=1
# ROLE_MENU_CHANNEL_ID=       # канал с панелью «Уведомления и роли меню»
# ROLE_MENU_MESSAGE=Уведомления и роли меню
# ROLE_MENU_ROLES=Роль1,Роль2
# ROLE_MENU_MAX_VALUES=10

# ── ИИ-чат (Gemini, port из Node chat_ai) ─────────────────────────────────────
# GEMINI_API_KEY=             # ключ Google AI Studio; без него ИИ выключен
# AI_ENABLED=1
# AI_CHANNELS=111,222         # ID каналов, где бот отвечает
# AI_MODEL=gemini-3.6-flash
# AI_COOLDOWN_SECONDS=45
# AI_TEMPERATURE=0.9
# AI_MAX_TOKENS=220
# AI_HISTORY_SIZE=12
# AI_TIMEOUT_SECONDS=45
# AI_SYSTEM_PROMPT=

# ── Соцсети (/socials) ──────────────────────────────────────────────────────────
# SOCIALS_DISCORD=
# SOCIALS_SITE=
# SOCIALS_YOUTUBE=
# SOCIALS_TWITCH=
# SOCIALS_DONATE=

# ── Права категорий (permissions, port из Node) ────────────────────────────────
# GUILD_ID=                   # ID сервера, на котором применять права
# PERMISSIONS_AUTO_APPLY=1    # применить при старте (и "/apply_permissions")
# PERMISSIONS_CATEGORIES=     # JSON: {"<category_id>": {"name": "...", "rules": [{"role": "@everyone", "view_channel": false}]}}

# ── Счётчики сервера (server_stats, port из Node) ──────────────────────────────
# SERVER_STATS_ENABLED=1
# SERVER_STATS_CATEGORY_ID=   # категория «СТАТИСТИКА»
# SERVER_STATS_UPDATE_SECONDS=300
# SERVER_STATS_CHANNELS=      # JSON: [{"name": "Участники", "emoji": "👥", "type": "members"}, ...]

# ── Приветствия (welcome, port из Node welcome.js) ─────────────────────────────
# WELCOME_ENABLED=1
# WELCOME_SEND_DM=1           # каталог каналов в ЛС новичку
# WELCOME_CHANNEL_ID=         # публичный пост о входе (WELCOME_CHANNEL_ENABLED=1)
# WELCOME_LEAVE_CHANNEL_ID=   # публичный пост об уходе (WELCOME_LEAVE_CHANNEL_ENABLED=1)
# WELCOME_TITLE=
# WELCOME_INTRO=
# WELCOME_FOOTER=
# WELCOME_CHANNEL_DESCRIPTIONS=   # JSON: {"канал": "описание"}
# WELCOME_VOICE_DESCRIPTIONS=     # JSON: {"канал": "описание"}
# WELCOME_HIDDEN_VOICE=           # JSON: ["канал1"]

# ── Сезоны (seasons, port из Node season.js / engagement.js) ──────────────────
# SEASON_ENABLED=1
# SEASON_REWARD_ROLES=Чемпион сезона,Серебро сезона,Бронза сезона
# SEASON_ANNOUNCE_CHANNEL_ID=

# ── Яндекс Музыка (ссылки music.yandex.* в /music play) ───────────────────────
# YANDEX_MUSIC_TOKEN=         # токен аккаунта Yandex с подпиской Плюс (даёт прямые ссылки)

# ── Авто-модерация (discord_automod, port из Node automod.js) ─────────────────
# AUTOMOD_ENABLED=1
# AUTOMOD_BANNED_WORDS=слово1,слово2
# AUTOMOD_BLOCK_LINKS=1
# AUTOMOD_ALLOWED_LINKS=twitch.tv,youtube.com
# AUTOMOD_CAPS_THRESHOLD=0.8
# AUTOMOD_CAPS_MIN_LEN=12
# AUTOMOD_MAX_MESSAGES_IN_WINDOW=5
# AUTOMOD_TIMEOUT_SECONDS=300
# AUTOMOD_BAN_AFTER_TIMEOUTS=3
# AUTOMOD_BAN_WINDOW_SECONDS=300
# AUTOMOD_IGNORE_ROLES=Owner,Moderator
# AUTOMOD_IGNORED_CHANNELS=